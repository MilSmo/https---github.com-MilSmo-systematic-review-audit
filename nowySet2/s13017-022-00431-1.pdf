            xmlns:author="http://springernature.com/ns/xmpExtensions/2.0/authorInfo/">
         <sn:authorInfo>
            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <author:name>Massimo Sartelli</author:name>
                  <author:orcid>http://orcid.org/0000-0003-3202-7542</author:orcid>
               </rdf:li>
            </rdf:Bag>
         </sn:authorInfo>
