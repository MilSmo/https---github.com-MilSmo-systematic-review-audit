      "chunk_id": "text_1",
      "document_title": "Does using 3D printed models for pre-operative planning improve surgical outcomes of foot and ankle fracture fixation? A systematic review and meta-analysis",
      "type": "text",
      "section": "Abstract",
      "merged_headings": [],
