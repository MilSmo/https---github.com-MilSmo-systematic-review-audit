    {
      "chunk_id": "text_6",
      "document_title": "Active and Passive Immunization with Myelin Basic Protein as a Method for Early Treatment of Traumatic Spinal Cord Injury; a Meta-Analysis",
      "type": "text",
      "section": "Data Collection And Quality Assessment",
